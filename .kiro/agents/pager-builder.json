{
  "name": "pager-builder",
  "description": "Builder agent for the 8282 Korean pager revival project. Loads project steering docs and the pager-8282 spec as resource context. Hook: PostToolUse runs npm test on file writes; SessionStart prints git status.",
  "resources": [
    ".kiro/steering/product.md",
    ".kiro/steering/tech.md",
    ".kiro/steering/structure.md",
    ".kiro/specs/pager-8282/requirements.md",
    ".kiro/specs/pager-8282/design.md",
    ".kiro/specs/pager-8282/tasks.md"
  ],
  "hooks": {
    "postToolUse": {
      "matcher": "fs_write|str_replace|fs_append",
      "command": "npm test --silent"
    },
    "sessionStart": {
      "command": "git status --short"
    }
  },
  "tools": [
    "read_file",
    "write_file",
    "edit_file",
    "execute_bash",
    "grep_search",
    "file_search",
    "list_directory"
  ]
}
